--- !u!114 &3004975714410991217
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2999154471962858526}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7d6c5ef9e9a6f91459970b096f3224f3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UIRootView
  m_loadingScreen: {fileID: 1915906196347014694}
  m_loadingText: {fileID: 5395627006945771558}
  m_loadingScreenCanvas: {fileID: 3527683512288914934}
  m_loadingScreenSortingOrder: 1000
  m_phrases:
  - "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u043D\u0430\u0437\u0430\u0434
    \u2014 \u044D\u0442\u043E \u043D\u0435 \u0431\u0430\u0433, \u044D\u0442\u043E
    \u0436\u0430\u043D\u0440."
  - "\u041A\u0430\u0436\u0434\u0430\u044F \u043D\u043E\u0432\u0430\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
    \u2014 \u044D\u0442\u043E \u043D\u0435 \u0430\u043F\u0433\u0440\u0435\u0439\u0434.
    \u042D\u0442\u043E \u043A\u043B\u044E\u0447 \u043A \u043C\u0435\u0441\u0442\u0443,
    \u0433\u0434\u0435 \u0442\u044B \u0443\u0436\u0435 \u0431\u044B\u043B."
  - "\u0415\u0441\u043B\u0438 \u0432\u0440\u0430\u0433 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u0441\u0438\u043B\u044C\u043D\u044B\u0439 \u2014 \u044D\u0442\u043E \u043D\u0435
    \u0447\u0435\u0441\u0442\u043D\u044B\u0439 \u0431\u043E\u0439. \u042D\u0442\u043E
    \u043D\u0430\u043C\u0451\u043A."
  - "73% \u0441\u0435\u043A\u0440\u0435\u0442\u043E\u0432 \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F
    \u0437\u0430 \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
    \u0441\u0442\u0435\u043D\u0430\u043C\u0438. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    27% \u2014 \u0435\u0449\u0451 \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0435\u0435."
  - "\u0423\u0440\u043E\u043D \u2014 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E.
    \u041F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441
    \u2014 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
  - "\u0411\u043E\u0441\u0441\u044B \u0442\u043E\u0436\u0435 \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u044E\u0442
    \u043F\u0435\u0440\u0435\u0434 \u0432\u0441\u0442\u0440\u0435\u0447\u0435\u0439
    \u0441 \u0442\u043E\u0431\u043E\u0439. \u041F\u0440\u043E\u0441\u0442\u043E \u043E\u043D\u0438
    \u044D\u0442\u043E \u043B\u0443\u0447\u0448\u0435 \u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442."
  - "\u0415\u0441\u043B\u0438 \u043F\u0443\u0442\u044C \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
    \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u043C \u2014 \u0437\u043D\u0430\u0447\u0438\u0442,
    \u0442\u044B \u0435\u0449\u0451 \u043D\u0435 \u0441\u0442\u0430\u043B \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
    \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u043C."
  - "\u0413\u0435\u0440\u043E\u0439 \u0434\u0435\u043B\u0430\u0435\u0442 \u0432\u0438\u0434,
    \u0447\u0442\u043E \u044D\u0442\u043E \u0432\u0441\u0451 \u043F\u043E \u043F\u043B\u0430\u043D\u0443."
